# Preserve recovered/interchange geometry and animation files through Git LFS.
*.cgf filter=lfs diff=lfs merge=lfs -text
*.skin filter=lfs diff=lfs merge=lfs -text
*.chr filter=lfs diff=lfs merge=lfs -text
*.caf filter=lfs diff=lfs merge=lfs -text
*.dae filter=lfs diff=lfs merge=lfs -text

# Preserve CryEngine text descriptors verbatim.
*.mtl -text
*.chrparams -text
*.xml -text

# Keep authored pipeline scripts and git metadata consistent across platforms.
*.py text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
